}

.empty-wrap {
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.empty-text {
  font-size: 26px;
  color: #ffffff;
}

.empty-sub {
  margin-top: 8px;
  font-size: 20px;
  color: #6e7681;
}

.actions {
  width: 100%;
  height: 84px;
  margin-bottom: 12px;
  flex-direction: column;
  justify-content: center;
}

.btn-primary {
  width: 100%;
  height: 62px;
  border-radius: 31px;
  background-color: #34d399;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.btn-text {
  font-size: 25px;
  font-weight: bold;
  color: #06251b;
}

.grade-row {
  width: 100%;
  height: 74px;
  flex-direction: row;
  justify-content: space-between;
}

.grade-btn {
  width: 31%;
  height: 74px;
  border-radius: 16px;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.grade-forgot {
  background-color: #3a1d20;
}

.grade-hard {
  background-color: #3a331c;
}

.grade-good {
  background-color: #14372c;
}

.grade-title {
  font-size: 25px;
  font-weight: bold;
  color: #ffffff;
}

.grade-sub {
  margin-top: 2px;
