  margin-top: 4px;
  font-size: 18px;
  color: #5c636a;
  text-align: center;
}

.divider {
  width: 100%;
  height: 1px;
  margin: 14px 0 10px;
  background-color: #262b30;
}

.def-scroll {
  width: 100%;
