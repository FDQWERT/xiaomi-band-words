  flex-direction: column;
  background-color: #000000;
}

.top-bar {
  width: 100%;
  height: 44px;
  margin-top: 8px;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.title {
  font-size: 28px;
  font-weight: bold;
  color: #ffffff;
}

.back-btn {
  font-size: 21px;
  color: #34d399;
}

.grid {
  width: 100%;
  margin-top: 8px;
  flex-direction: row;
  justify-content: space-between;
}

.grid-item {
  flex: 1;
  height: 78px;
  margin: 0 3px;
  border-radius: 16px;
  background-color: #16191c;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.grid-num {
  font-size: 32px;
  font-weight: bold;
  color: #ffffff;
}

.num-green {
  color: #34d399;
}

.grid-label {
  margin-top: 2px;
  font-size: 18px;
  color: #8b949e;
}

.chart-title {
  width: 100%;
  margin-top: 16px;
  font-size: 21px;
  color: #8b949e;
}

.chart {
  width: 100%;
  height: 110px;
  margin-top: 8px;
  flex-direction: row;
  align-items: flex-end;
  justify-content: space-between;
}

.chart-col {
  flex: 1;
  height: 100%;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
}

.chart-num {
  font-size: 15px;
  color: #6e7681;
  margin-bottom: 3px;
}

.chart-bar {
  width: 14px;
  border-radius: 7px;
  background-color: #34d399;
}

.chart-day {
  margin-top: 5px;
  font-size: 15px;
  color: #6e7681;
}

.foot-note {
  width: 100%;
  margin-top: 10px;
  flex-direction: row;
  justify-content: center;
}

.foot-text {
  font-size: 18px;
  color: #5c636a;
}
</style>
