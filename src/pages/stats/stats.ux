<template>
  <div class="page">
    <div class="top-bar">
      <text class="title">学习统计</text>
      <text class="back-btn" onclick="back">返回</text>
    </div>

    <div class="grid">
      <div class="grid-item">
        <text class="grid-num">{{ learned }}</text>
        <text class="grid-label">已学</text>
      </div>
      <div class="grid-item">
        <text class="grid-num num-green">{{ mastered }}</text>
        <text class="grid-label">已掌握</text>
      </div>
    </div>
    <div class="grid">
      <div class="grid-item">
        <text class="grid-num">{{ streak }}</text>
        <text class="grid-label">连续天数</text>
      </div>
      <div class="grid-item">
        <text class="grid-num">{{ studyDays }}</text>
        <text class="grid-label">累计学习天</text>
      </div>
    </div>

    <text class="chart-title">未来 7 天待复习</text>
    <div class="chart">
      <block for="{{ item in bars }}">
        <div class="chart-col">
          <text class="chart-num">{{ item.count }}</text>
          <div class="chart-bar" style="height: {{ item.height }}px"></div>
          <text class="chart-day">{{ item.label }}</text>
        </div>
      </block>
    </div>

    <div class="foot-note">
      <text class="foot-text">词库进度 {{ learned }} / {{ total }}</text>
    </div>
  </div>
</template>

<script>
import router from "@system.router"

const store = require("../../common/store.js")

const WEEK_LABEL = ["日", "一", "二", "三", "四", "五", "六"]

export default {
  private: {
    learned: 0,
    mastered: 0,
    streak: 0,
    studyDays: 0,
    total: 0,
    bars: []
  },

  onInit() {
    store.load(() => this.refresh())
  },

  onShow() {
    if (!store.ready()) {
      store.load(() => this.refresh())
      return
    }
    store.reload(() => this.refresh())
  },

  refresh() {
    if (!store.ready()) return
    const info = store.summary()
    this.learned = info.learned
    this.mastered = info.mastered
    this.streak = info.streak
    this.studyDays = info.studyDays
    this.total = store.wordCount()

    const counts = store.upcoming(7)
    let max = 1
    for (let i = 0; i < counts.length; i++) {
      if (counts[i] > max) max = counts[i]
    }
    const today = new Date()
    const bars = []
    for (let i = 0; i < counts.length; i++) {
      const date = new Date(today.getFullYear(), today.getMonth(), today.getDate() + i)
      bars.push({
        count: counts[i],
        height: Math.max(4, Math.round((counts[i] / max) * 64)),
        label: i === 0 ? "今" : "周" + WEEK_LABEL[date.getDay()]
      })
    }
    this.bars = bars
  },

  back() {
    router.back()
  }
}
</script>

